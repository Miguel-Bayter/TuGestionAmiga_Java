# ======================================================
# Archivo de ejemplo para configurar la conexión a MySQL
# ======================================================
#
# Uso recomendado:
# 1) Copia este archivo y renómbralo a: db.properties
# 2) Completa db.user y db.password con tus credenciales reales
# 3) Verifica que db.url apunte a tu base y puerto correctos
#
# IMPORTANTE:
# - El archivo real db.properties NO debe subirse a Git.
# - En este proyecto, db.properties está ignorado por .gitignore.

# URL JDBC (ajusta host/puerto/base si es necesario)
# Formato: jdbc:mysql://HOST:PUERTO/NOMBRE_BD?parametros
# Ejemplo:
# db.url=jdbc:mysql://localhost:3306/tugestionamiga_db?useSSL=false&serverTimezone=UTC

db.url=jdbc:mysql://localhost:3306/tugestionamiga_db?useSSL=false&serverTimezone=UTC

# Credenciales de MySQL
# (Ejemplo: root)
db.user=root

# Coloca aquí la contraseña real de tu usuario MySQL
# Ejemplo:
# db.password=123456

db.password=
