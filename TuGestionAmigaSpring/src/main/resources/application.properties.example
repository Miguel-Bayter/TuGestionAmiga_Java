# Copia este archivo como "application.properties" y completa los valores
# (o usa variables de entorno DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD).

server.port=8080

# --- MySQL ---
# Opción 1 (recomendada): variables de entorno
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:tugestionamiga_db}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}

# Opción 2: valores fijos (descomenta y edita)
# spring.datasource.url=jdbc:mysql://localhost:3306/tugestionamiga_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
# spring.datasource.username=root
# spring.datasource.password=TU_PASSWORD

spring.thymeleaf.cache=false
logging.level.org.springframework.security=INFO
